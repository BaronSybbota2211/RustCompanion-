<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:RustCompanion.App"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- Брендовые цвета «Щита»: тёмная сталь + красные детали. Красный акцент и фоны темы — в Theme.xaml. -->
    <SolidColorBrush x:Key="SteelBrush" Color="#2A2627"/>
    <SolidColorBrush x:Key="SteelEdgeBrush" Color="#4A4446"/>
    <SolidColorBrush x:Key="RedDeepBrush" Color="#C41F28"/>

    <!-- Эмблема (векторная, чёткая при любом размере). Размер сцены 120x132, соотношение сторон сохраняется Stretch="Uniform". -->
    <DrawingImage x:Key="AppLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M-2,-2 L122,-2 L122,134 L-2,134 Z"/>
                <GeometryDrawing Brush="#302C2D" Geometry="M0,0 L60,0 L60,132 L0,80 Z"/>
                <GeometryDrawing Brush="#262324" Geometry="M60,0 L120,0 L120,80 L60,132 Z"/>
                <GeometryDrawing Geometry="M0,0 L120,0 L120,80 L60,132 L0,80 Z">
                    <GeometryDrawing.Pen><Pen Brush="#4A4446" Thickness="2" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M6,6 L114,6 L114,78 L60,124 L6,78 Z">
                    <GeometryDrawing.Pen><Pen Brush="#663033" Thickness="1" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#5A5456">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="11,16" RadiusX="2.2" RadiusY="2.2"/>
                            <EllipseGeometry Center="109,16" RadiusX="2.2" RadiusY="2.2"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F02B32" Geometry="M0,0 L120,0 L120,6 L0,6 Z"/>
                <DrawingGroup Transform="0.95,0,0,0.95,13.5,8">
                    <GeometryDrawing Brush="#E8E2DF" Geometry="F0 M20,15 L62,15 L76,25 L76,45 L66,55 L78,85 L60,85 L50,60 L38,60 L38,85 L20,85 Z M38,30 L58,30 L58,45 L38,45 Z"/>
                </DrawingGroup>
                <GeometryDrawing Geometry="M10,84 L60,122 L110,84">
                    <GeometryDrawing.Pen><Pen Brush="#C41F28" Thickness="5" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Фон уведомления Overlay: тёмная пластина со срезанными углами, красной линией сверху и стальной рамкой. Тип события меняет только AccentBrush. -->
    <Style x:Key="ToastCard" TargetType="local:ChamferBorder">
        <Setter Property="Background" Value="#1D1A1B"/>
        <Setter Property="BorderBrush" Value="{StaticResource SteelEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="AccentBrush" Value="#F02B32"/>
        <Setter Property="AccentThickness" Value="2"/>
        <Setter Property="Chamfer" Value="10"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- Кнопки окна в верхней панели (свернуть, развернуть, закрыть). Цвет при наведении — в Tag (у «Закрыть» красный). -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Tag" Value="#3A171A"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#5A1B20"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
