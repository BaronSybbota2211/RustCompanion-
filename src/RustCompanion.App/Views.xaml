<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RustCompanion.App.ViewModels"
                    xmlns:svc="clr-namespace:RustCompanion.App.Services">

    <!-- Обзор -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22,26,28">
                <TextBlock Text="ОБЗОР СИСТЕМЫ" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Командный центр" Style="{StaticResource H1}" FontSize="27" Margin="0,3,0,2"/>
                <TextBlock Text="Быстрый доступ к инструментам Rust Companion" Style="{StaticResource Muted}" Margin="0,0,0,17"/>

                <Border Background="{StaticResource AccentGradient}" BorderBrush="#F04A4A" BorderThickness="1" Padding="16,13" Margin="0,0,0,16">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="BRUTAL RED" FontSize="10" FontWeight="Bold" Foreground="#FFE3E3" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="SURVIVE. MONITOR. CONTROL." FontSize="15" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="Инструменты сервера, события и устройства — в одном месте." FontSize="11" Foreground="#F5DADA" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,15">
                    <Button Content="＋  Новый таймер" Command="{Binding GoTimersCommand}"/>
                    <Button Content="＋  Добавить сервер" Command="{Binding GoServersCommand}" Background="#292526"/>
                    <Button Content="Гниение" Command="{Binding GoDecayCommand}" Background="#292526"/>
                </WrapPanel>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,7,10" MinHeight="170">
                        <StackPanel>
                            <TextBlock Text="ИЗБРАННЫЕ СЕРВЕРЫ" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                            <TextBlock Text="Нет избранных серверов. Добавьте сервер на вкладке «Серверы» и отметьте звёздочкой."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding NoServers, Converter={StaticResource BoolVis}}"/>
                            <ItemsControl ItemsSource="{Binding FavoriteServers}">
                                <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#38272A" BorderThickness="0,0,0,1" Padding="0,8"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="7,0,0,10" MinHeight="170">
                        <StackPanel>
                            <TextBlock Text="БЛИЖАЙШИЕ СОБЫТИЯ" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                            <TextBlock Text="Нет запущенных таймеров." Style="{StaticResource Muted}" Visibility="{Binding NoTimers, Converter={StaticResource BoolVis}}"/>
                            <ItemsControl ItemsSource="{Binding ActiveTimers}">
                                <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#38272A" BorderThickness="0,0,0,1" Padding="0,8"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="СОВЕТ: настройте опрос серверов и Steam в разделе «Настройки», чтобы получать актуальные данные." Style="{StaticResource Muted}" FontSize="11" Margin="2,2,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Группа: ручной таймер + прогноз одного события -->
    <DataTemplate DataType="{x:Type vm:GroupViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                <ItemsControl ItemsSource="{Binding Sections}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Content="{Binding Header}" Padding="14,6" Margin="0,0,8,0"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{Binding Selected.Header}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            </StackPanel>
            <ContentControl Content="{Binding Current}"/>
        </DockPanel>
    </DataTemplate>

    <!-- Трекеры -->
    <DataTemplate DataType="{x:Type vm:TrackerViewModel}">
        <DockPanel Margin="24">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="ТАЙМЕРЫ / СОБЫТИЯ" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}"/>
                <WrapPanel Margin="0,12,0,4">
                    <StackPanel Margin="0,0,0,6"><TextBlock Text="Название" Style="{StaticResource Muted}"/><TextBox Width="200" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Margin="0,0,0,6"><TextBlock Text="Интервал, мин" Style="{StaticResource Muted}"/><TextBox Width="110" Text="{Binding NewIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Margin="0,0,0,6"><TextBlock Text="Предупредить за, мин" Style="{StaticResource Muted}"/><TextBox Width="130" Text="{Binding NewLeadMinutes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <Button Content="Добавить" Command="{Binding AddCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Muted}" Text="Таймеров пока нет. Заполните поля выше и нажмите «Добавить»."
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource CardBorder}"><StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PhaseText}" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Border Background="#241114" BorderBrush="#713035" BorderThickness="1" Padding="10,5" Margin="0,7,0,6" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding RemainingText}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            </Border>
                            <TextBlock Text="{Binding DueText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding IntervalText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Muted}" FontStyle="Italic"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                <Button Content="{Binding StartLabel}" Command="{Binding StartCommand}"/>
                                <Button Content="{Binding MarkLabel}" Command="{Binding MarkCommand}"/>
                                <Button Content="Сбросить" Command="{Binding ResetCommand}" Background="#3A424B"/>
                                <Button Content="Удалить" Command="{Binding DeleteCommand}" Background="#3A424B"/>
                            </StackPanel>
                            <DockPanel Margin="0,4,0,4">
                                <Button DockPanel.Dock="Right" Content="Сохранить заметку" Command="{Binding SaveNoteCommand}" Margin="0"/>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- Серверы -->
    <DataTemplate DataType="{x:Type vm:ServersViewModel}">
        <DockPanel Margin="24">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Серверы" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Text="Опрос по протоколу Steam Query (A2S). Нужен адрес и query-порт сервера (он может отличаться от игрового). «Нет ответа» не означает, что сервер выключен."/>
                <WrapPanel Margin="0,12,0,4">
                    <StackPanel><TextBlock Text="Название" Style="{StaticResource Muted}"/><TextBox Width="180" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel><TextBlock Text="Адрес" Style="{StaticResource Muted}"/><TextBox Width="180" Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel><TextBlock Text="Query-порт" Style="{StaticResource Muted}"/><TextBox Width="90" Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <Button Content="Добавить" Command="{Binding AddCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                    <Button Content="Опросить сейчас" Command="{Binding RefreshAllCommand}" VerticalAlignment="Bottom" Background="#3A424B"/>
                </WrapPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Muted}" Text="Серверов пока нет." Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,4,0"><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{StaticResource PanelGradient}" BorderBrush="#713035" BorderThickness="1" Padding="0" Margin="0,0,0,11" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource AccentGradient}"/>
                        <Grid Grid.Column="1" Margin="15,12,13,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Address}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="★  Избранный" IsChecked="{Binding Favorite, Mode=OneWay}" Command="{Binding ToggleFavoriteCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                            <Border Grid.Row="1" Background="#171113" BorderBrush="#422327" BorderThickness="1" Padding="9,7" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DetailsText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LastSuccessText}" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Удалить" Command="{Binding RemoveCommand}" Background="#302326" Padding="10,5" Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- Игроки -->
    <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
        <DockPanel Margin="24">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="МОНИТОРИНГ / STEAM" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                <TextBlock Text="Игроки Steam" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Text="Публичные данные Steam Web API (нужен ваш ключ в «Настройках»). Если профиль или детали игры скрыты, приложение так и покажет — «в Rust сейчас» выводится только когда Steam это сообщает."/>
                <WrapPanel Margin="0,12,0,4">
                    <StackPanel><TextBlock Text="SteamID64" Style="{StaticResource Muted}"/><TextBox Width="200" Text="{Binding NewSteamId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel><TextBlock Text="Метка" Style="{StaticResource Muted}"/><TextBox Width="160" Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <Button Content="Добавить" Command="{Binding AddCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                    <Button Content="Проверить сейчас" Command="{Binding RefreshAllCommand}" VerticalAlignment="Bottom" Background="#3A424B"/>
                </WrapPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Muted}" Text="Профилей пока нет." Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,4,0"><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{StaticResource PanelGradient}" BorderBrush="#713035" BorderThickness="1" Padding="0" Margin="0,0,0,11" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource AccentGradient}"/>
                        <Grid Grid.Column="1" Margin="15,12,14,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="STEAM PLAYER / WATCHLIST" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="УДАЛИТЬ" Command="{Binding RemoveCommand}" Background="#302326" Padding="11,6" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="10"/>
                            </Grid>
                            <Border Grid.Row="1" Background="#171113" BorderBrush="#422327" BorderThickness="1" Padding="10,8" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding DetailsText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- О программе -->
    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="О программе" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,8"/>
            <TextBlock Text="Версия" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Version}" Margin="0,0,0,6"/>
            <TextBlock Text="Дата обновления" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ReleaseDate}" Margin="0,0,0,6"/>
            <TextBlock Text="Авторство" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Author}" Margin="0,0,0,6"/>
            <TextBlock Text="Контакты (Telegram)" Style="{StaticResource Muted}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <TextBlock Text="{Binding TelegramHandle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Написать в Telegram" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding TelegramUrl}" Padding="10,2"/>
            </StackPanel>
            <TextBlock Text="Поддержать развитие" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            <TextBlock Text="Программа бесплатная. Добровольное пожертвование поможет её развитию — спасибо!" TextWrapping="Wrap" Margin="0,2,0,6"/>
            <Button Content="Добровольное пожертвование" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding DonateUrl}" HorizontalAlignment="Left" Padding="14,4"/>
            <TextBlock Text="Источники данных" Style="{StaticResource H1}" Margin="0,22,0,6" FontSize="16"/>
            <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Открыть" Padding="8,1" VerticalAlignment="Top" Margin="10,0,0,0"
                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding Url}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding Url}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Purpose}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Программа не читает память игры, не внедряется в процесс Rust и не обходит EAC. Ключи API хранятся на вашем компьютере в зашифрованном виде (DPAPI)." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="11"/>
        </StackPanel></ScrollViewer>
    </DataTemplate>

    <!-- Настройки -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource H1}"/>
            <TextBlock Text="Интервал опроса серверов, с" Style="{StaticResource Muted}"/><TextBox Text="{Binding ServerPollSeconds, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Text="Интервал опроса Steam, с" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBox Text="{Binding SteamPollSeconds, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Text="Тайм-аут запроса, с" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBox Text="{Binding RequestTimeoutSeconds, UpdateSourceTrigger=LostFocus}"/>
            <CheckBox Content="Опрашивать серверы" IsChecked="{Binding ServerMonitoringEnabled}" Margin="0,12,0,0"/>
            <CheckBox Content="Опрашивать Steam" IsChecked="{Binding SteamMonitoringEnabled}"/>
                        <CheckBox Content="Сворачивать в трей при закрытии окна" IsChecked="{Binding CloseToTray}"/>
            <TextBlock Text="Ключ Steam Web API" FontWeight="SemiBold" Margin="0,16,0,2"/>
            <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Muted}"/>
            <TextBox Text="{Binding SteamKeyInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
            <TextBlock Text="Ключ RustMaps API" FontWeight="SemiBold" Margin="0,16,0,2"/>
            <TextBlock Text="{Binding RustMapsKeyStatus}" Style="{StaticResource Muted}"/>
            <TextBox Text="{Binding RustMapsKeyInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Получить ключ на rustmaps.com" Command="{Binding OpenRustMapsDashboardCommand}" Background="#3A424B"/>
                <Button Content="Удалить ключ RustMaps" Command="{Binding DeleteRustMapsKeyCommand}" Background="#3A424B"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
                <Button Content="Удалить ключ" Command="{Binding DeleteKeyCommand}" Background="#3A424B"/>
            </StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock Text="Наблюдение за игроками (Steam Query)" FontWeight="SemiBold" Margin="0,20,0,2"/>
            <TextBlock Text="Интервал проверки игроков, с (не меньше 30)" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBox Text="{Binding WatchPollSeconds, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Text="Подтверждений отсутствия для «Выход подтверждён»" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBox Text="{Binding AbsenceConfirmations, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Text="Мин. интервал между уведомлениями, с" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBox Text="{Binding NotifyMinIntervalSeconds, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Text="Внешние каналы (Telegram / Discord)" FontWeight="SemiBold" Margin="0,16,0,2"/>
            <TextBlock Style="{StaticResource Muted}" Text="Какие события и каким способом показывать — на вкладке «Уведомления» (по умолчанию всё выключено)."/>
            <CheckBox Content="Telegram" IsChecked="{Binding TelegramEnabled}"/>
            <TextBlock Text="Токен бота Telegram" Style="{StaticResource Muted}"/><TextBox Text="{Binding TelegramTokenInput, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Chat ID" Style="{StaticResource Muted}" Margin="0,6,0,0"/><TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Проверить Telegram" Command="{Binding TestTelegramCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            <CheckBox Content="Discord" IsChecked="{Binding DiscordEnabled}" Margin="0,10,0,0"/>
            <TextBlock Text="URL вебхука Discord" Style="{StaticResource Muted}"/><TextBox Text="{Binding DiscordWebhookInput, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Проверить Discord" Command="{Binding TestDiscordCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding IntegrationStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            <TextBlock Text="Данные" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <CheckBox Content="Включать историю событий в экспорт" IsChecked="{Binding ExportActivity}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Экспорт" Command="{Binding ExportDataCommand}"/>
                <Button Content="Импорт" Command="{Binding ImportDataCommand}" Background="#3A424B"/>
                <Button Content="Резервная копия БД" Command="{Binding BackupDatabaseCommand}" Background="#3A424B"/>
            </StackPanel>
            <TextBlock Text="Диагностика источников" FontWeight="SemiBold" Margin="0,20,0,4"/>
            <Button Content="Обновить" Command="{Binding RefreshDiagnosticsCommand}" HorizontalAlignment="Left"/>
            <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <!-- Наблюдение -->
    <DataTemplate DataType="{x:Type vm:WatchViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
            <TextBlock Text="Наблюдение за игроками" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Text="Данные Steam Query (A2S): ник и время, которое сообщил сервер; SteamID не передаётся, игрок определяется по нику. Время проверки не равно точному времени входа или выхода. «Выход подтверждён» — только после нескольких успешных проверок подряд; ошибки сети в счёт не идут."/>
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,10"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/></Border>
            <TextBlock Text="{Binding Message}" Style="{StaticResource ErrorText}" Margin="0,0,0,6"/>

            <TextBlock Text="1. Сервер" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,4,0,4">
                <ComboBox Width="260" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Margin="0,0,8,0"/>
                <Button Content="Удалить сервер" Command="{Binding RemoveServerCommand}" Background="{StaticResource Line}" Margin="0,0,16,0"
                        ToolTip="Удаляет выбранный сервер и всех наблюдаемых на нём игроков; сервер пропадёт и со вкладки «Серверы»"/>
                <TextBox Width="200" Text="{Binding ServerQuery, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Найти сервер" Command="{Binding SearchServersCommand}"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Muted}" Text="Серверов нет: найдите сервер по названию и добавьте." Visibility="{Binding NoServers, Converter={StaticResource BoolVis}}"/>
            <ItemsControl ItemsSource="{Binding ServerResults}"><ItemsControl.ItemTemplate><DataTemplate>
                <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Content="Добавить" Margin="8,0,0,0"
                            Command="{Binding DataContext.AddServerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

            <TextBlock Text="2. Группы" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <WrapPanel Margin="0,4,0,4">
                <TextBox Width="150" Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Width="80" Text="{Binding NewGroupColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="Цвет #RRGGBB"/>
                <TextBox Width="60" Text="{Binding NewGroupThreshold, UpdateSourceTrigger=PropertyChanged}" ToolTip="Порог: сколько игроков группы на сервере"/>
                <Button Content="Создать группу" Command="{Binding AddGroupCommand}"/>
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate>
                <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Content="Удалить" Background="#3A424B" Margin="8,0,0,0"
                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                    <TextBlock><Run Text="■ " Foreground="{Binding Color}"/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  порог: "/><Run Text="{Binding Threshold, Mode=OneWay}"/></TextBlock>
                </DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

            <TextBlock Text="3. Добавить игрока в наблюдение" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,4" TextWrapping="Wrap" Text="Вставьте SteamID64 или ссылку на профиль Steam. Ник берётся из Steam, а наблюдение привязывается к SteamID64, поэтому следим именно за этим человеком, а не за совпадением ника."/>
