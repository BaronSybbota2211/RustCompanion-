<Window x:Class="RustCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RUST COMPANION" Width="1480" Height="920" MinWidth="960" MinHeight="620" FontSize="13" FontFamily="Segoe UI"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <!-- Системная рамка убрана, но привязка к краям (Snap), перетаскивание за панель, изменение размера и системное меню работают средствами Windows -->
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="RootFrame" Background="{StaticResource Bg}" BorderBrush="#4A4446" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Верхняя панель: эмблема, название, статус Rust+, кнопки окна -->
        <Border Grid.Row="0" Background="#111011" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{StaticResource AppLogo}" Width="22" Height="24" Margin="12,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="RUST COMPANION" FontSize="13" FontWeight="Bold" Foreground="#F0ECEA" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="1" Height="18" Background="#3A3436" Margin="0,0,14,0"/>
                    <Ellipse Width="8" Height="8" Fill="{Binding RustPlus.StateColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Rust+  " FontSize="12" Foreground="#A39B99" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RustPlus.StateText}" FontSize="12" Foreground="#A39B99" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" ToolTip="Свернуть" Click="OnMinimize">
                        <Path Data="M0,0.5 L10,0.5" Stroke="#E8E2DF" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" ToolTip="Развернуть" Click="OnMaxRestore">
                        <Grid Width="10" Height="10">
                            <Rectangle x:Name="MaxGlyph" Stroke="#E8E2DF" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                            <Path x:Name="RestoreGlyph" Data="M2.5,0.75 L9.25,0.75 L9.25,7.5 M0.75,2.5 L7.5,2.5 L7.5,9.25 L0.75,9.25 Z" Stroke="#E8E2DF" StrokeThickness="1.5" Visibility="Collapsed" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Tag="#C41F28" ToolTip="Закрыть (в трей)" Click="OnClose">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#F0ECEA" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Левая навигационная панель -->
        <Border Grid.Column="0" Background="#0B0C0D" BorderBrush="#5A1B20" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="7,13,7,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="1" Background="#111213" BorderBrush="#492024" BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#20C45A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ПРИЛОЖЕНИЕ ГОТОВО" FontSize="9" FontWeight="Bold" Foreground="#B7B0AE"/>
                        </StackPanel>
                        <TextBlock Text="BRUTAL RED  /  DESKTOP" FontSize="9" Foreground="#746D6B" Margin="16,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Рабочая область -->
        <Grid Grid.Column="1" Background="{StaticResource Bg}">
            <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ContentControl Grid.Row="0" Content="{Binding Current}" Margin="0"/>
        </Grid>
    </Grid>
    </Grid>
    </Border>
</Window>
